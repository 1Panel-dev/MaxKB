# MaxKB v2.0 分离部署环境配置文件
# 复制此文件为 .env 并根据实际情况修改配置

# ================================
# 基础配置
# ================================

# 私有镜像仓库地址 (留空使用 Docker Hub)
REGISTRY=harbor.company.com/maxkb

# 镜像标签
TAG=v2.0

# 数据持久化目录
DATA_DIR=/opt/maxkb-data

# Docker 网络名称
NETWORK=maxkb-network

# ================================
# 数据库配置
# ================================

# PostgreSQL 配置
DB_HOST=maxkb-postgres
DB_PORT=5432
DB_USER=maxkb
DB_PASSWORD=your-secure-db-password
DB_NAME=maxkb

# ================================
# Redis 配置
# ================================

# Redis 配置
REDIS_HOST=maxkb-redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_DB=0

# ================================
# 应用端口配置
# ================================

# 后台应用端口
BACKEND_PORT=8080

# 前端页面端口
FRONTEND_PORT=80

# ================================
# 日志级别
# ================================

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ================================
# 高级配置 (可选)
# ================================

# 最大数据库连接数
DB_MAX_CONNECTIONS=1000

# Redis 最大连接数
REDIS_MAX_CONNECTIONS=100

# 会话超时时间 (秒)
SESSION_TIMEOUT=28800

# 语言设置
LANGUAGE_CODE=zh-CN

# 时区设置
TIME_ZONE=Asia/Shanghai

# ================================
# 集群配置 (高级用户)
# ================================

# Redis 哨兵模式 (可选)
# REDIS_SENTINEL_SENTINELS=sentinel1:26379,sentinel2:26379,sentinel3:26379
# REDIS_SENTINEL_MASTER=mymaster

# 外部数据库 (如果使用现有数据库)
# EXTERNAL_DB_HOST=your-db-host
# EXTERNAL_DB_PORT=5432
# EXTERNAL_DB_USER=your-db-user
# EXTERNAL_DB_PASSWORD=your-db-password

# 外部 Redis (如果使用现有 Redis)
# EXTERNAL_REDIS_HOST=your-redis-host
# EXTERNAL_REDIS_PORT=6379
# EXTERNAL_REDIS_PASSWORD=your-redis-password