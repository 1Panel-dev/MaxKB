# MaxKB 后台应用 Dockerfile
FROM ghcr.io/1panel-dev/maxkb-base:python3.11-pg17.5 AS backend-build

# 安装系统依赖
ARG DEPENDENCIES="                    \
        libexpat1-dev                 \
        libffi-dev                    \
        curl                          \
        ca-certificates               \
        gettext                       \
        postgresql-client             \
        build-essential               \
        git"

RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    apt-get update && \
    apt-get install -y --no-install-recommends $DEPENDENCIES && \
    apt-get clean all && \
    rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /opt/maxkb-app

# 复制应用代码 (排除前端和安装文件)
COPY . /opt/maxkb-app
RUN rm -rf /opt/maxkb-app/ui && \
    rm -rf /opt/maxkb-app/installer

# 配置 pip 镜像源（解决网络超时问题）
RUN mkdir -p /root/.pip && \
    echo '[global]' > /root/.pip/pip.conf && \
    echo 'index-url = https://mirrors.aliyun.com/pypi/simple/' >> /root/.pip/pip.conf && \
    echo 'trusted-host = mirrors.aliyun.com' >> /root/.pip/pip.conf && \
    echo 'timeout = 300' >> /root/.pip/pip.conf && \
    echo 'retries = 5' >> /root/.pip/pip.conf

# 创建 Python 虚拟环境并安装依赖
RUN python3 -m venv /opt/py3 && \
    . /opt/py3/bin/activate && \
    pip install poetry==2.0.0 && \
    # 配置 Poetry
    poetry config virtualenvs.create false && \
    poetry config installer.max-workers 10 && \
    poetry config installer.timeout 300 && \
    # 处理 x86 架构下的 torch 依赖
    if [ "$(uname -m)" = "x86_64" ]; then sed -i 's/^torch.*/torch = {version = "2.7.1+cpu", source = "pytorch"}/g' pyproject.toml; fi && \
    # 检查并添加 PyPI 源
    if ! poetry source show aliyun >/dev/null 2>&1; then \
        poetry source add --priority=primary aliyun https://mirrors.aliyun.com/pypi/simple/; \
    fi && \
    poetry source show && \
    rm -f poetry.lock && \
    poetry lock && \
    poetry install --only=main && \
    pip install requests pymysql psycopg2-binary

# 编译国际化文件
RUN . /opt/py3/bin/activate && \
    export MAXKB_CONFIG_TYPE=ENV && \
    python3 /opt/maxkb-app/apps/manage.py compilemessages

# 创建沙箱环境
RUN mkdir -p /opt/maxkb-app/sandbox && \
    useradd --no-create-home --home /opt/maxkb-app/sandbox sandbox -g root && \
    chown -R sandbox:root /opt/maxkb-app/sandbox

# 最终镜像
FROM ghcr.io/1panel-dev/maxkb-base:python3.11-pg17.5

# 安装运行时依赖
RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        postgresql-client \
        wait-for-it && \
    apt-get clean all && \
    rm -rf /var/lib/apt/lists/*

# 设置环境变量
ENV MAXKB_CONFIG_TYPE=ENV \
    MAXKB_DB_NAME=maxkb \
    MAXKB_DB_HOST=maxkb-postgres \
    MAXKB_DB_PORT=5432 \
    MAXKB_DB_USER=maxkb \
    MAXKB_DB_ENGINE=dj_db_conn_pool.backends.postgresql \
    MAXKB_DB_MAX_OVERFLOW=80 \
    MAXKB_REDIS_HOST=maxkb-redis \
    MAXKB_REDIS_PORT=6379 \
    MAXKB_REDIS_DB=0 \
    MAXKB_REDIS_MAX_CONNECTIONS=100 \
    MAXKB_LOCAL_MODEL_HOST=127.0.0.1 \
    MAXKB_LOCAL_MODEL_PORT=11636 \
    MAXKB_LOCAL_MODEL_PROTOCOL=http \
    MAXKB_SANDBOX=1 \
    MAXKB_LOG_LEVEL=INFO \
    MAXKB_SANDBOX_PYTHON_PACKAGE_PATHS="/opt/py3/lib/python3.11/site-packages,/opt/maxkb-app/sandbox/python-packages,/opt/maxkb/python-packages" \
    MAXKB_SANDBOX_PYTHON_BANNED_KEYWORDS="subprocess.,system(,exec(,pty.,eval(,compile(,shutil.,input(,__import__" \
    MAXKB_ADMIN_PATH=/admin \
    MAXKB_CHAT_PATH=/chat \
    PATH=/opt/py3/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    LANG=en_US.UTF-8

# 复制应用和虚拟环境
COPY --from=backend-build /opt/maxkb-app /opt/maxkb-app
COPY --from=backend-build /opt/py3 /opt/py3

# 创建启动脚本
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
echo "等待数据库连接..."\n\
wait-for-it ${MAXKB_DB_HOST}:${MAXKB_DB_PORT} --timeout=120 --strict\n\
\n\
echo "等待 Redis 连接..."\n\
wait-for-it ${MAXKB_REDIS_HOST}:${MAXKB_REDIS_PORT} --timeout=60 --strict\n\
\n\
echo "创建必要目录..."\n\
mkdir -p /opt/maxkb/logs\n\
mkdir -p /opt/maxkb/local\n\
mkdir -p /opt/maxkb/python-packages\n\
\n\
echo "清理临时文件..."\n\
rm -f /opt/maxkb-app/tmp/*.pid\n\
\n\
echo "启动 MaxKB 后台应用..."\n\
cd /opt/maxkb-app\n\
python main.py start' > /usr/local/bin/start-maxkb-backend.sh && \
    chmod +x /usr/local/bin/start-maxkb-backend.sh

WORKDIR /opt/maxkb-app

EXPOSE 8080

# 数据卷
VOLUME ["/opt/maxkb/logs", "/opt/maxkb/local", "/opt/maxkb-app/model"]

CMD ["/usr/local/bin/start-maxkb-backend.sh"]