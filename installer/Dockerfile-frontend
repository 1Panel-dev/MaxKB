# MaxKB 前端页面 Dockerfile
FROM node:18-alpine3.18 AS frontend-build

# 设置工作目录
WORKDIR /app

# 复制前端代码
COPY ui /app

# 安装依赖并构建
RUN npm install && \
    NODE_OPTIONS="--max-old-space-size=4096" npm run build && \
    NODE_OPTIONS="--max-old-space-size=4096" npm run build-chat

# 最终镜像
FROM nginx:1.25-alpine

# 复制构建好的前端文件
COPY --from=frontend-build /app/dist /usr/share/nginx/html

# 创建默认的 Nginx 配置模板
RUN echo 'server {\n\
    listen 80;\n\
    server_name localhost;\n\
    \n\
    # 前端静态文件\n\
    location / {\n\
        root /usr/share/nginx/html;\n\
        index index.html;\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    \n\
    # API 代理到后台\n\
    location /api/ {\n\
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
        proxy_read_timeout 300s;\n\
        proxy_connect_timeout 75s;\n\
    }\n\
    \n\
    # 管理后台代理\n\
    location /admin/ {\n\
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/admin/;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
    }\n\
    \n\
    # 聊天接口代理\n\
    location /chat/ {\n\
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/chat/;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
        \n\
        # WebSocket 支持\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Upgrade $http_upgrade;\n\
        proxy_set_header Connection "upgrade";\n\
        proxy_read_timeout 86400;\n\
    }\n\
    \n\
    # 静态资源缓存\n\
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
    \n\
    # 安全头\n\
    add_header X-Frame-Options "SAMEORIGIN" always;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-XSS-Protection "1; mode=block" always;\n\
}' > /etc/nginx/conf.d/default.conf.template

# 设置环境变量默认值
ENV BACKEND_HOST=maxkb-backend \
    BACKEND_PORT=8080

# 创建启动脚本
RUN echo '#!/bin/sh\n\
set -e\n\
\n\
echo "配置 Nginx..."\n\
envsubst '"'"'$BACKEND_HOST $BACKEND_PORT'"'"' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf\n\
\n\
echo "启动 Nginx..."\n\
nginx -g "daemon off;"' > /docker-entrypoint.sh && \
    chmod +x /docker-entrypoint.sh

EXPOSE 80

CMD ["/docker-entrypoint.sh"]