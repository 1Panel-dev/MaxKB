# 阶段1: 构建环境
FROM ghcr.io/1panel-dev/maxkb-base:python3.11-pg17.5 AS backend-builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# 安装构建依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libffi-dev \
        libexpat1-dev \
        git \
        curl \
        ca-certificates \
        gettext \
    && rm -rf /var/lib/apt/lists/* && \
    apt-get clean

WORKDIR /build

# 配置 pip 镜像源
RUN mkdir -p /root/.pip && \
    echo '[global]' > /root/.pip/pip.conf && \
    echo 'index-url = https://mirrors.aliyun.com/pypi/simple/' >> /root/.pip/pip.conf && \
    echo 'trusted-host = mirrors.aliyun.com' >> /root/.pip/pip.conf && \
    echo 'timeout = 300' >> /root/.pip/pip.conf && \
    echo 'retries = 5' >> /root/.pip/pip.conf

# 安装 uv 包管理器
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.cargo/bin/uv /usr/local/bin/ || true

# 创建虚拟环境
RUN python3 -m venv /opt/py3

COPY pyproject.toml /build/

# 使用 uv 安装依赖（支持阿里云镜像）
RUN export UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ && \
    python3 -c "import tomllib; deps = tomllib.load(open('pyproject.toml', 'rb'))['dependencies']; open('requirements.txt', 'w').write('\n'.join(deps))" && \
    uv pip install --python /opt/py3/bin/python --no-cache -r requirements.txt && \
    /opt/py3/bin/pip install --no-cache-dir --timeout 300 --retries 5 \
        -i https://mirrors.aliyun.com/pypi/simple/ \
        --trusted-host mirrors.aliyun.com \
        requests pymysql psycopg2-binary

COPY apps/ /build/apps/
COPY main.py /build/

RUN . /opt/py3/bin/activate && \
    export MAXKB_CONFIG_TYPE=ENV && \
    python3 /build/apps/manage.py compilemessages

# 安全清理：只清理缓存、字节码、测试目录，保留 dist-info 和 pip
RUN find /opt/py3 -type d -name "__pycache__" -exec rm -rf {} + \
 && find /opt/py3 -type f -name "*.py[co]" -delete \
 && find /opt/py3/lib/python3.11/site-packages -type d -name "tests" -exec rm -rf {} + \
 && find /opt/py3 -type d -name ".pytest_cache" -exec rm -rf {} +

# 阶段2: 运行时镜像
FROM ghcr.io/1panel-dev/maxkb-base:python3.11-pg17.5 AS backend-runtime

# 设置时区
RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# 安装必要运行库
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        postgresql-client \
        wait-for-it \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/* && \
    apt-get clean

# 环境变量
ENV MAXKB_CONFIG_TYPE=ENV \
    MAXKB_DB_NAME=maxkb \
    MAXKB_DB_HOST=maxkb-postgres \
    MAXKB_DB_PORT=5432 \
    MAXKB_DB_USER=maxkb \
    MAXKB_DB_ENGINE=dj_db_conn_pool.backends.postgresql \
    MAXKB_DB_MAX_OVERFLOW=80 \
    MAXKB_REDIS_HOST=maxkb-redis \
    MAXKB_REDIS_PORT=6379 \
    MAXKB_REDIS_DB=0 \
    MAXKB_REDIS_MAX_CONNECTIONS=100 \
    MAXKB_LOCAL_MODEL_HOST=127.0.0.1 \
    MAXKB_LOCAL_MODEL_PORT=11636 \
    MAXKB_LOCAL_MODEL_PROTOCOL=http \
    MAXKB_SANDBOX=1 \
    MAXKB_LOG_LEVEL=INFO \
    MAXKB_SANDBOX_PYTHON_PACKAGE_PATHS="/opt/py3/lib/python3.11/site-packages,/opt/maxkb-app/sandbox/python-packages,/opt/maxkb/python-packages" \
    MAXKB_SANDBOX_PYTHON_BANNED_KEYWORDS="subprocess.,system(,exec(,pty.,eval(,compile(,shutil.,input(,__import__" \
    MAXKB_ADMIN_PATH=/admin \
    MAXKB_CHAT_PATH=/chat \
    PATH=/opt/py3/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LANG=en_US.UTF-8

# 添加用户
RUN useradd --no-create-home --home /opt/maxkb-app --shell /bin/bash maxkb -g root

# 复制应用文件
COPY --from=backend-builder /build /opt/maxkb-app
COPY --from=backend-builder /opt/py3 /opt/py3

ENV PYTHONPATH=/opt/maxkb-app/apps

# 创建目录并修复权限
RUN mkdir -p /opt/maxkb-app/sandbox/execute \
             /opt/maxkb-app/sandbox/result \
             /opt/maxkb/logs \
             /opt/maxkb/local \
             /opt/maxkb/cache \
             /opt/maxkb/python-packages && \
    chown -R maxkb:root /opt/maxkb-app /opt/maxkb && \
    chmod -R 755 /opt/maxkb-app /opt/maxkb && \
    chmod +rx /bin/bash /bin/ls /usr/bin/env  # ✅ 关键权限修复

# 轻量启动脚本
COPY --chmod=755 <<'EOF' /usr/local/bin/start-maxkb-backend.sh
#!/bin/bash
set -e

export PYTHONPATH="${PYTHONPATH:-/opt/maxkb-app/apps}"

echo "等待数据库连接..."
wait-for-it ${MAXKB_DB_HOST}:${MAXKB_DB_PORT} --timeout=120 --strict

echo "等待 Redis 连接..."
wait-for-it ${MAXKB_REDIS_HOST}:${MAXKB_REDIS_PORT} --timeout=60 --strict

echo "创建必要目录..."
mkdir -p /opt/maxkb/logs /opt/maxkb/local /opt/maxkb/cache /opt/maxkb/python-packages
mkdir -p /opt/maxkb-app/sandbox/execute /opt/maxkb-app/sandbox/result

echo "清理临时文件..."
rm -f /opt/maxkb-app/tmp/*.pid 2>/dev/null || true

echo "启动 MaxKB 后台应用..."
cd /opt/maxkb-app
exec python main.py start
EOF

WORKDIR /opt/maxkb-app

# USER maxkb

EXPOSE 8080

VOLUME ["/opt/maxkb/logs", "/opt/maxkb/local", "/opt/maxkb/cache", "/opt/maxkb-app/model", "/opt/maxkb-app/sandbox"]

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/api/health || exit 1

CMD ["/usr/local/bin/start-maxkb-backend.sh"]
